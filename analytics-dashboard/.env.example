# URLs de las apps del sistema Brotes
# Si no están configuradas, el dashboard usa datos mock automáticamente

# Buyer App — donde vive la ruta /api/analytics
BUYER_APP_URL=

# Seller App — donde vive la ruta /api/analytics
SELLER_APP_URL=

# Payments App — donde vive la ruta /api/analytics
PAYMENTS_APP_URL=

# Service API Keys de cada app (el dashboard las envía en el header x-api-key)
# Cada app valida su propia key para autorizar el acceso
BUYER_APP_API_KEY=
SELLER_APP_API_KEY=
PAYMENTS_APP_API_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
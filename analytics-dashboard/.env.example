# URLs de las apps del sistema Brotes
# Si no están configuradas, el dashboard usa datos mock automáticamente

# Buyer App — donde vive la ruta /api/analytics
BUYER_APP_URL=

# Seller App — donde vive la ruta /api/analytics
SELLER_APP_URL=

# Payments App — donde vive la ruta /api/analytics
PAYMENTS_APP_URL=

# API key que el dashboard envía en el header x-api-key
# Las otras apps deben validar este valor para autorizar el acceso
ANALYTICS_API_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=